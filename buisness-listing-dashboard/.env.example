# ============================================================
# Root .env.example  –  copy to .env and fill in real values
# Used by docker-compose.yml (MySQL service) and the backend.
# NEVER commit the real .env file.
# ============================================================

# ── MySQL Docker service ───────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpass

# ── Application database ───────────────────────────────────
DB_NAME=listings_db
DB_USER=listings_user
DB_PASSWORD=listings_pass
DB_PORT=3306
