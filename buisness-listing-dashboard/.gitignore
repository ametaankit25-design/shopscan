# ============================================================
# .gitignore – Business Listings Dashboard
# ============================================================

# ── Secrets ────────────────────────────────────────────────
.env
!.env.example

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyc
venv/
.venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/

# ── Database files ─────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Data files (can be large) ──────────────────────────────
backend/data/raw_listings.json
backend/data/clean_listings.json
backend/data/sample_page.html

# ── Node / React ───────────────────────────────────────────
node_modules/
frontend/dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS / Editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.suo
*.ntvs*
*.njsproj
*.sln
