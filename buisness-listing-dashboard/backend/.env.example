# ============================================================
# backend/.env.example
# Copy to backend/.env and fill in real values.
# The backend reads these at startup via pydantic-settings.
# DB_PASSWORD is required (no default); it must match the root .env.
# ============================================================

# ── Database ───────────────────────────────────────────────
DB_USER=listings_user
DB_PASSWORD=listings_pass
DB_HOST=localhost
DB_PORT=3306
DB_NAME=listings_db

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins (React dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
